# backend/.env.example  -> copy to backend/.env and fill in. NEVER commit .env.
# Only used on your laptop (npm run dev / migrations). On Lambda these values come
# from Secrets Manager (secrets) and Lambda environment variables (settings).

# --- secrets (local only) ---
# Neon OWNER connection string, used for migrations and local dev.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# One Neon role per service (least privilege, see database/005_app_role_grants.sql).
# If left empty, infra/scripts/01-foundation.sh uses DATABASE_URL for all three.
CUSTOMERS_DATABASE_URL=
POINTS_DATABASE_URL=
REWARDS_DATABASE_URL=
# Brevo transactional e-mail key. Leave empty locally to skip sending (email_status = skipped).
BREVO_API_KEY=

# --- settings (not secret) ---
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:8080,http://localhost:4566
LOCAL_SERVICE_CALLS=true

# Floci (local AWS). The SDK reads these automatically.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Cognito values printed by infra/scripts/02-cognito.sh
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_ISSUER=http://localhost:4566/REPLACE_WITH_POOL_ID

IDEMPOTENCY_TABLE=LoyaltyIdempotency
EMAIL_QUEUE_URL=
REPORTS_BUCKET=loyalty-reports-private
EMAIL_SENDER=no-reply@loyaltyhub.example
