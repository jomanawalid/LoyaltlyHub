{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OwnLogsOnly",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:__REGION__:__ACCOUNT__:log-group:/aws/lambda/loyalty-points-api:*"
    },
    {
      "Sid": "ReadOwnDatabaseSecretOnly",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:__REGION__:__ACCOUNT__:secret:loyalty/points/database-url*"
    },
    {
      "Sid": "IdempotencyTableItemsOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:dynamodb:__REGION__:__ACCOUNT__:table/LoyaltyIdempotency"
    },
    {
      "Sid": "CallCustomersOnly",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:__REGION__:__ACCOUNT__:function:loyalty-customers-api"
    },
    {
      "Sid": "PublishAlertsOnly",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:__REGION__:__ACCOUNT__:loyalty-alerts"
    }
  ]
}
