{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OwnLogsOnly",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:__REGION__:__ACCOUNT__:log-group:/aws/lambda/loyalty-alert-handler:*"
    }
  ]
}
